---
interface Props {
  items: readonly { pregunta: string; respuesta: string }[];
  /** Abre el primer elemento por defecto. */
  abrirPrimero?: boolean;
  clase?: string;
}

const { items, abrirPrimero = true, clase = '' } = Astro.props;
---

<div class={`divide-y divide-crema-200 overflow-hidden rounded-[var(--radius-pieza)] border border-crema-200 bg-superficie ${clase}`}>
  {
    items.map((item, indice) => (
      <details class="group" open={abrirPrimero && indice === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left transition hover:bg-crema-50 [&::-webkit-details-marker]:hidden sm:px-6 sm:py-5">
          <span class="font-display text-base font-semibold text-tinta-900 sm:text-lg">
            {item.pregunta}
          </span>
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-crema-300 bg-crema-50 text-barro-600 transition group-open:rotate-45 group-open:border-barro-300 group-open:bg-barro-50"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 text-sm leading-relaxed text-tinta-600 sm:px-6 sm:pb-6 sm:text-base">
          {item.respuesta}
        </div>
      </details>
    ))
  }
</div>
