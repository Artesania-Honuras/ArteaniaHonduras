# Dependencias
node_modules/
.pnpm-store/
.npm-cache/

# Salida de build
dist/
.astro/
.output/

# Entorno y secretos
.env
.env.*
!.env.example

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
pnpm-debug.log*

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Cachés de herramientas
.eslintcache
*.tsbuildinfo

# Copias temporales para revisión de código de terceros (nunca se publican)
_revision/

# Fotografías originales sin procesar: no se publican, solo se optimizan con
# `npm run fotos:procesar`, que escribe el resultado en public/imagenes/fotos/
fotos-originales/

# Obsidian: se versiona la configuración de la bóveda (app, apariencia, plugins
# activados y plantillas), pero NO el estado local de cada persona ni la caché.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.trash/
docs/adjuntos/
